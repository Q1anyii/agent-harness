# ============================================================
# agent-harness 环境变量模板（复制为 .env 后按需配置）
# Windows: copy .env.example .env
# .env 已被 .gitignore 忽略（不会提交）；本模板可提交、可修改
# 说明：模板值即"零配置可跑"的默认（Mock LLM + 内存存储），复制为 .env 后可直接启动；
#       需要真实 LLM 时改 LLM_BACKEND=deepseek 并填 DEEPSEEK_API_KEY（缺失时启动即报 ValueError）；
#       需要落库持久化时改 SESSION_STORE / LOG_STORE 为 sqlite
# ============================================================

# ---------------- LLM 后端 ----------------
# mock（默认）：规则式模拟，零配置可跑；deepseek：真实 DeepSeek API
LLM_BACKEND=mock

# DeepSeek 平台 API 密钥（身份认证）
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容接口地址
BASE_URL=https://api.deepseek.com

# 模型名称（provider:model 格式，兼容 Ollama 风格调用）
MODEL_NAME=deepseek-flash

# ---------------- 存储 ----------------
# 会话/消息/trace 存储后端：memory（默认，进程内）| sqlite（落库持久化）
SESSION_STORE=memory

# SQLite 数据库文件路径（SESSION_STORE=sqlite 时生效，目录自动创建）
SESSION_DB=data/agent-harness.db

# 请求日志后端：memory（默认）| sqlite（复用 SESSION_DB）
LOG_STORE=memory

# ---------------- 服务 ----------------
# 后端监听端口（默认 8000；Windows Hyper-V/WSL2 保留段 7449-8248 冲突时换端口）
PORT=8000
